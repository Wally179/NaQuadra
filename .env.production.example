# ============================================================
# Na Quadra — Production Environment Variables Template
# ============================================================

# ── API (Backend - Render) ──
PORT=4000
NODE_ENV=production
SKIP_DB=false
CORS_ORIGIN=https://naquadra.vercel.app

# Neon PostgreSQL
DATABASE_URL=postgresql://user:password@ep-host.region.aws.neon.tech/neondb?sslmode=require

# MongoDB Atlas
MONGODB_URI=mongodb+srv://user:password@cluster0.mongodb.net/naquadra?retryWrites=true&w=majority

# JWT Auth
JWT_SECRET=super_secret_key_change_me_in_production
JWT_EXPIRES_IN=7d
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ESPN API Base URL (Internal mapping)
ESPN_BASE_URL=https://site.api.espn.com/apis/site/v2/sports/basketball/nba


# ── Web (Frontend - Vercel) ──
NEXT_PUBLIC_API_URL=https://naquadra-api.onrender.com
