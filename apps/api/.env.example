       # ============================================================
# Na Quadra API — Environment Variables
# ============================================================

# Server
NODE_ENV=development
PORT=4000
SKIP_DB=false

# ──────────────────────────────────────
# Bancos de Dados (Local via Docker)
# Para nuvem: troque pelas URLs do Neon Postgres e MongoDB Atlas
# ──────────────────────────────────────
# PostgreSQL (Substituir pela URL do Neon)
DATABASE_URL=postgresql://postgres:postgres_dev_password@localhost:5432/naquadra

# MongoDB (Substituir pela URI do MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/naquadra

# ──────────────────────────────────────
# JWT Auth
# ──────────────────────────────────────
JWT_SECRET=nq-dev-jwt-secret-change-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=nq-dev-refresh-secret-change-in-production
JWT_REFRESH_EXPIRATION=7d

# ──────────────────────────────────────
# Configurações ESPN API e Web
# ──────────────────────────────────────
ESPN_BASE_URL=https://site.api.espn.com/apis/site/v2/sports/basketball/nba
ESPN_SCOREBOARD_INTERVAL_SEC=30

CORS_ORIGIN=http://localhost:3000

THROTTLE_TTL=60000
THROTTLE_LIMIT=100
